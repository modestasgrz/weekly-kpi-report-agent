# Example only, not installed by the code. Every Monday 07:00: report last week, leave a Gmail draft.
# Exit code 0 = ok, 2 = needs review, 3 = no data; cron mails non-empty output to the crontab owner.
0 7 * * 1 cd /path/to/weekly-kpi-report-agent && uv run weekly-kpi-report run --data data/raw/online_retail_II.xlsx
